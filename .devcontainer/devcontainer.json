{
  "name": "Diyarak Platform .NET 10",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/diyarak-platform",
  "postCreateCommand": "dotnet restore Diyarak.Platform.All.sln",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml",
        "eamodio.gitlens"
      ]
    }
  },
  "remoteUser": "root"
}
