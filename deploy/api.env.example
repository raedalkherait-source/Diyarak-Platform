# Copy to deploy/api.env (never commit it). ASP.NET Core settings for the API container.
# Nested keys use double underscores.

# Phone sign-in (ADR-0052). Issuer: the public API URL. Signing key: openssl rand -base64 32
Authentication__Phone__Enabled=true
Authentication__Phone__Issuer=https://api.diyarak.app
Authentication__Phone__Audience=diyarak-api
Authentication__Phone__SigningKey=
# Short-lived access tokens; the portal renews them from the 30-day refresh token (ADR-0062).
Authentication__Phone__AccessTokenLifetimeMinutes=15
Authentication__Phone__OtpSender=HttpGateway

# SMS provider (ADR-0059): adjust to your provider's API documentation.
Messaging__Sms__Http__Endpoint=https://sms-provider.example/api/send
Messaging__Sms__Http__Method=GET
Messaging__Sms__Http__Encoding=Query
Messaging__Sms__Http__Parameters__to={phoneLocal}
Messaging__Sms__Http__Parameters__text={message}
Messaging__Sms__Http__Parameters__key={apiKey}
Messaging__Sms__Http__ApiKey=
# Messaging__Sms__Http__SuccessBodyContains=

# Moderators (ADR-0058): verified phone numbers in E.164.
Moderation__ModeratorPhoneNumbers__0=+9639XXXXXXXX
