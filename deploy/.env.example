# Copy to deploy/.env (never commit it). Values used by docker compose itself.
PORTAL_DOMAIN=diyarak.app
API_DOMAIN=api.diyarak.app
# Address that receives certificate expiry notices from Let's Encrypt.
ACME_EMAIL=
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
